# Database: leave empty for the embedded dev database (./data); set for PostgreSQL in production
DATABASE_URL=
DATA_DIR=./data
STORAGE_DIR=./data/files
PORT=3000
NODE_ENV=production
# Required in production: long random string
SESSION_SECRET=
# First-start administrator (use the roster email so roster and job-runner identity line up)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# AI analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional email
SMTP_URL=
MAIL_FROM=
# Keep false until Base44 collection is switched off, so sources are not fetched twice
SCHEDULER_ENABLED=false
# "Retrieve sample" on the Source review page (sourceReview inspect). Off unless DIRECT_FETCH_ENABLED=true.
# FETCH_CONTACT is required when enabled: a URL or email address (no spaces) that goes into the user agent.
# Nothing else (collection, discovery, research, the scheduler) uses direct retrieval.
DIRECT_FETCH_ENABLED=false
FETCH_CONTACT=
FETCH_TIMEOUT_MS=20000
FETCH_MAX_BYTES=10485760
FETCH_MAX_REDIRECTS=5
# Browser-rendering fallback for script-rendered pages (same allowlist and limits). Needs Playwright/Chromium.
FETCH_RENDER=false
