{
  "name": "LicenceCertificate",
  "type": "object",
  "properties": {
    "record_ref": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "Supplier licence",
        "Game certification",
        "Studio approval",
        "Other"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "gray"
      ]
    },
    "jurisdiction_id": {
      "type": "string"
    },
    "jurisdiction_name": {
      "type": "string"
    },
    "legal_entity_name": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "studio_name": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "reference_number": {
      "type": "string",
      "description": "Unknown when not evidenced"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Pending",
        "Suspended",
        "Expired",
        "Unknown"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red",
        "gray",
        "gray"
      ]
    },
    "issued_date": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string"
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "No evidence on file",
        "Evidence uploaded",
        "Evidence verified"
      ],
      "enumColors": [
        "red",
        "yellow",
        "green"
      ]
    },
    "evidence_file_uri": {
      "type": "string"
    },
    "evidence_note": {
      "type": "string"
    }
  },
  "required": [
    "record_type",
    "jurisdiction_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "data.access_admitted": true
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}